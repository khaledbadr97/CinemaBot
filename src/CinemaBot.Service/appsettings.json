    "ArabicUrl": "https://egy.voxcinemas.com/ar/movies/comingsoon",
    "ScanIntervalMinutes": 5,
    "PageSize": 8,
    "MaximumDirectBookingButtons": 30
  },
  "Scan": {
    "MaximumConcurrentRequests": 6,
    "MaximumConcurrentArabicRequests": 4
  },
  "Telegram": {
    "BotToken": "",
    "ChatId": "",
    "ChannelUsername": "@CinemaBotEG",
    "RequireChannelSubscription": true,
    "AdminUserIds": [
      "1503985349"
    ],
    "ButtonsOnlyMode": true,
    "DeleteTypedMessages": true,
    "DigestMaximumLength": 3500,
